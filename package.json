{
  "name": "inventoriman",
  "private": true,
  "version": "0.0.0",
  "description": "Offline-first desktop POS and inventory management system.",
  "author": "InventoriMan",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "check:electron": "node scripts/check-electron-syntax.cjs",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "test": "npm run rebuild:node && node --test tests/*.test.cjs",
    "posttest": "npm run rebuild:electron",
    "pretest:electron-smoke": "npm run rebuild:electron",
    "test:electron-smoke": "node scripts/electron-smoke.cjs",
    "release:check": "npm run check:electron && npm run lint && npm run typecheck && npm test && npm run build && npm run test:electron-smoke",
    "preview": "vite preview",
    "preelectron": "npm run rebuild:electron",
    "electron": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dev:electron": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron\"",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:win:arm64": "npm run build && electron-builder --win --arm64"
  },
  "build": {
    "appId": "com.inventoriman.pos",
    "productName": "Inventory Manager POS",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron",
        "to": "electron",
        "filter": [
          "**/*"
        ]
      },
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "@types/react-date-range": "^1.4.10",
    "better-sqlite3": "^12.6.2",
    "date-fns": "^4.1.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.7.3",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.3",
    "react": "^19.2.0",
    "react-date-range": "^2.0.1",
    "react-dom": "^19.2.0",
    "react-qr-code": "^2.0.18",
    "recharts": "^3.7.0",
    "uuid": "^13.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "electron": "^40.4.1",
    "electron-builder": "^26.8.1",
    "electron-is-dev": "^3.0.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "framer-motion": "^12.34.0",
    "globals": "^16.5.0",
    "lucide-react": "^0.564.0",
    "postcss": "^8.5.6",
    "tailwind-merge": "^3.4.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  }
}
